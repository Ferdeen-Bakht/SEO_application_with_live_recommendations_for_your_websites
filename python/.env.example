# The live website to review (read-only; this tool never writes to it)
SITE_URL=https://appcreatorz.com

# Browser used to render JavaScript sites (already installed on Windows): msedge or chrome
BROWSER_CHANNEL=msedge

# Ollama local model runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# SQLite database used by the dashboard
SEO_DB_PATH=../data/seo_lab.db

# Keyword rankings: "searxng" (free, run your own instance with JSON enabled) or "mojeek" (paid official API)
SERP_PROVIDER=searxng
SEARXNG_URL=http://127.0.0.1:8080
MOJEEK_API_KEY=

# Safety ceiling for "unlimited" crawls (pages per site)
CRAWL_HARD_LIMIT=2000

# dev.to API key for the Create backlinks page (get one at dev.to/settings/extensions)
DEVTO_API_KEY=
